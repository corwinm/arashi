{
  "version": "1.0.0",
  "repos_dir": "repos",
  "worktree_strategy": "same_branch",
  "auto_setup": true,
  "discovered_repos": {
    "frontend": {
      "path": "repos/frontend",
      "default_branch": "main",
      "remote": "origin",
      "has_setup_script": true,
      "git_url": "git@github.com:user/frontend.git"
    },
    "backend": {
      "path": "repos/backend",
      "default_branch": "master",
      "remote": "origin",
      "has_setup_script": false,
      "git_url": "git@github.com:user/backend.git"
    },
    "shared-lib": {
      "path": "repos/shared-lib",
      "default_branch": "main",
      "remote": "origin",
      "has_setup_script": true,
      "git_url": "git@github.com:user/shared-lib.git"
    }
  }
}
