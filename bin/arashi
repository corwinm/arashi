#!/bin/bash
# Wrapper for arashi to fix fzf compatibility
# Bun's compiled executables don't properly close stdin, which blocks fzf
# from accessing /dev/tty for keyboard input. This wrapper closes stdin (0<&-)
# before executing the binary.

# Resolve the actual script path, following symlinks
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_SOURCE" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
BINARY="$SCRIPT_DIR/arashi.bin"

# Use the Windows binary only with explicit Git-for-Windows/MSYS/Cygwin evidence.
# arashi.bin always retains precedence when both binaries are present.
if [ ! -f "$BINARY" ]; then
  PLATFORM=$(uname -s | tr '[:upper:]' '[:lower:]')
  ARCH=$(uname -m)
  WINDOWS_SHELL="false"

  case "${MSYSTEM:-}" in
    MINGW*|MSYS*) WINDOWS_SHELL="true" ;;
  esac
  case "$PLATFORM" in
    mingw*|msys*|cygwin*) WINDOWS_SHELL="true" ;;
  esac

  if [ "$WINDOWS_SHELL" = "true" ]; then
    BINARY="$SCRIPT_DIR/arashi.bin.exe"
  else
    case "$PLATFORM-$ARCH" in
      darwin-arm64)
        BINARY="$SCRIPT_DIR/arashi-macos-arm64"
        ;;
      linux-x86_64)
        BINARY="$SCRIPT_DIR/arashi-linux-x64"
        ;;
      *)
        echo "Error: Unsupported platform $PLATFORM-$ARCH" >&2
        exit 1
        ;;
    esac
  fi
fi

if [ ! -f "$BINARY" ]; then
  echo "Error: arashi binary not found at $BINARY" >&2
  exit 1
fi

# Close stdin only when piping list output (fzf compatibility)
command=""
for arg in "$@"; do
  case "$arg" in
    -*)
      continue
      ;;
    *)
      if [ -z "$command" ]; then
        command="$arg"
      fi
      ;;
  esac
done

if [ ! -t 1 ]; then
  if [ "$command" = "list" ]; then
    exec "$BINARY" "$@" 0<&-
  fi
fi

exec "$BINARY" "$@"
