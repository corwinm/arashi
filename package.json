{
  "name": "arashi",
  "version": "0.1.0",
  "description": "Git worktree manager for meta-repositories - The eye of the storm for your development workflow",
  "type": "module",
  "bin": {
    "arashi": "./dist/arashi"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --minify --sourcemap --outfile dist/arashi",
    "build:all": "bun run build:mac && bun run build:linux && bun run build:windows",
    "build:mac": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/arashi-macos-arm64",
    "build:linux": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/arashi-linux-x64",
    "build:windows": "bun build src/index.ts --compile --target=bun-windows-x64 --outfile dist/arashi-windows-x64.exe",
    "test": "bun test",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "git",
    "worktree",
    "meta-repo",
    "monorepo",
    "cli",
    "development"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "@inquirer/prompts": "^7.2.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "latest"
  }
}
