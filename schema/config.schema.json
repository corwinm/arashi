{
  "$ref": "#/definitions/Config",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CommandDefaultsConfig": {
      "additionalProperties": false,
      "properties": {
        "create": {
          "$ref": "#/definitions/CreateCommandDefaults"
        },
        "editors": {
          "$ref": "#/definitions/EditorDefaultsConfig"
        },
        "switch": {
          "$ref": "#/definitions/SwitchCommandDefaults"
        }
      },
      "type": "object"
    },
    "Config": {
      "additionalProperties": false,
      "description": "Root configuration object for Arashi",
      "properties": {
        "$schema": {
          "description": "JSON Schema URL for editor validation/autocomplete",
          "type": "string"
        },
        "defaults": {
          "$ref": "#/definitions/CommandDefaultsConfig",
          "description": "Optional command-scoped defaults for create and switch"
        },
        "hooks": {
          "additionalProperties": false,
          "description": "Optional workspace-level hooks settings",
          "properties": {
            "timeout": {
              "description": "Lifecycle-hook timeout in milliseconds (default: 300000)",
              "maximum": 2147483647,
              "minimum": 1,
              "multipleOf": 1,
              "type": "number"
            }
          },
          "type": "object"
        },
        "repos": {
          "additionalProperties": {
            "$ref": "#/definitions/RepoConfig"
          },
          "description": "Map of repository names to their configurations",
          "type": "object"
        },
        "reposDir": {
          "description": "Directory where repositories are located",
          "type": "string"
        },
        "sync": {
          "additionalProperties": false,
          "description": "Optional sync command settings",
          "properties": {
            "timeoutSeconds": {
              "description": "Sync timeout in seconds",
              "type": "number"
            }
          },
          "type": "object"
        },
        "version": {
          "$ref": "#/definitions/ConfigVersion",
          "description": "Configuration schema version for migrations"
        },
        "worktreesDir": {
          "description": "Base directory where worktrees are created (workspace-relative)",
          "type": "string"
        }
      },
      "required": ["version", "reposDir", "repos"],
      "type": "object"
    },
    "ConfigVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "CreateCommandDefaults": {
      "additionalProperties": false,
      "properties": {
        "baseBranch": {
          "description": "Default base branch for configured create invocations",
          "minLength": 1,
          "pattern": "^(?!HEAD$)(?!origin/(?:HEAD$|-))(?![-/.])(?!.*(?:/\\.|//|\\.\\.|@\\{))(?!.*\\.lock(?:/|$))(?!.*[/.]$)[^\\u0000-\\u0020\\u007F~^:?*\\[\\\\]+$",
          "type": "string"
        },
        "launch": {
          "$ref": "#/definitions/CreateLaunchMode",
          "description": "Post-create launch choice; omitted preserves built-in no-launch behavior"
        },
        "switch": {
          "description": "Default to switching to the new worktree after create",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "CreateLaunchMode": {
      "enum": ["none", "auto", "sesh", "herdr"],
      "type": "string"
    },
    "EditorCommandDefaults": {
      "additionalProperties": false,
      "properties": {
        "create": {
          "$ref": "#/definitions/EditorCreateCommandDefaults",
          "description": "Editor-scoped create defaults"
        }
      },
      "type": "object"
    },
    "EditorCreateCommandDefaults": {
      "additionalProperties": false,
      "properties": {
        "launch": {
          "$ref": "#/definitions/CreateLaunchMode",
          "description": "Post-create launch choice; omitted preserves built-in no-launch behavior"
        },
        "switch": {
          "description": "Default to switching to the new worktree after create",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "EditorDefaultsConfig": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "$ref": "#/definitions/EditorCommandDefaults"
        },
        "kiro": {
          "$ref": "#/definitions/EditorCommandDefaults"
        },
        "vscode": {
          "$ref": "#/definitions/EditorCommandDefaults"
        }
      },
      "type": "object"
    },
    "RepoConfig": {
      "additionalProperties": false,
      "description": "Configuration for a single repository",
      "properties": {
        "gitUrl": {
          "description": "Canonical git URL for cloning the repository",
          "type": "string"
        },
        "groups": {
          "description": "Optional semantic groups this repository belongs to",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "description": "Path to the repository (relative or absolute)",
          "type": "string"
        }
      },
      "required": ["path"],
      "type": "object"
    },
    "SwitchCommandDefaults": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/definitions/SwitchMode",
          "description": "Preferred switch behavior and launcher when running switch"
        }
      },
      "type": "object"
    },
    "SwitchMode": {
      "enum": ["auto", "cd", "launch", "sesh", "herdr"],
      "type": "string"
    }
  }
}
